#!/bin/bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

run() {
  printf '\n==> %s\n' "$1"
  shift
  "$@"
}

run "Python unit tests" env PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests
run "Node model test" node tests/model.test.js

printf '\n==> Python compile\n'
python3 - <<'PY'
from pathlib import Path

paths = [Path("app/omawix"), *Path("lib").rglob("*.py"), *Path("tests").rglob("*.py")]
for path in paths:
    compile(path.read_bytes(), str(path), "exec")
print(f"Compiled {len(paths)} Python files")
PY

run "JSON validation" python3 -m json.tool manifest.json
run "Shell syntax" bash -n check setup remove-app

printf '\n==> Omarchy plugin validation\n'
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate .
else
  printf 'SKIP: omarchy is not installed\n'
fi

printf '\nAll available checks passed.\n'
