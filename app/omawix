    def clear_children(container: Gtk.Widget) -> None:
        while child := container.get_first_child():
            container.remove(child)

    def label(text: str, css: str | None = None, *, ellipsize: bool = False) -> Gtk.Label:
        widget = Gtk.Label(label=text, xalign=0)
        if css:
            widget.add_css_class(css)
        if ellipsize:
            widget.set_ellipsize(Pango.EllipsizeMode.END)
        return widget

    def button(text: str, callback, css: str | None = None) -> Gtk.Button:
        widget = Gtk.Button(label=text)
        widget.add_css_class("action-button")
        if css:
            widget.add_css_class(css)
        widget.connect("clicked", callback)
        return widget

