    def read_toml(path: Path) -> dict:
        try:
            with path.open("rb") as handle:
                return tomllib.load(handle)
        except (OSError, tomllib.TOMLDecodeError):
            return {}

    def valid_color(value: object, fallback: str) -> str:
        text = str(value or "")
        return text if re.fullmatch(r"#[0-9A-Fa-f]{6}", text) else fallback

    def theme_css() -> bytes:
        colors = read_toml(theme_root / "theme/colors.toml")
        background = valid_color(colors.get("background"), "#101315")
        surface = valid_color(colors.get("dark_background"), "#181825")
        foreground = valid_color(colors.get("foreground"), "#cacccc")
        muted = valid_color(colors.get("muted"), "#73777a")
        accent = valid_color(colors.get("accent") or colors.get("blue"), "#7aa2f7")
        urgent = valid_color(colors.get("bright_red") or colors.get("red"), "#f7768e")
        return f"""
          @define-color oma_bg {background};
          @define-color oma_surface {surface};
          @define-color oma_fg {foreground};
          @define-color oma_muted {muted};
          @define-color oma_accent {accent};
