                     background: transparent; color: @oma_muted; border-radius: 4px; }}
          .nav-button:hover, .action-button:hover {{ background: alpha(@oma_fg, .08); color: @oma_fg; }}
          .nav-button.active {{ color: @oma_accent; background: alpha(@oma_accent, .12); }}
          .primary {{ color: @oma_accent; border-color: alpha(@oma_accent, .45); }}
          .danger {{ color: @oma_urgent; }}
