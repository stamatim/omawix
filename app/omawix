def format_bytes(value: int | float) -> str:
    size = max(0.0, float(value or 0))
    units = ["B", "KB", "MB", "GB", "TB"]
    index = 0
    while size >= 1000 and index < len(units) - 1:
        size /= 1000
        index += 1
    decimals = 0 if size >= 100 or index == 0 else (1 if size >= 10 else 2)
    number = f"{size:.{decimals}f}"
    if "." in number:
        number = number.rstrip("0").rstrip(".")
    return f"{number} {units[index]}"


def format_duration(seconds: int | None) -> str:
    if seconds is None:
        return "--"
    minutes, second = divmod(max(0, seconds), 60)
    hours, minute = divmod(minutes, 60)
    return f"{hours}h {minute}m" if hours else f"{minute}m {second}s"


def resolve_command_line_path(value: str, cwd: str) -> Path:
    path = Path(value).expanduser()
    if not path.is_absolute():
        path = Path(cwd) / path
    return path.resolve()


