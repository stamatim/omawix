        def show_mode(self, mode: str) -> None:
            if self.mode == "reader" and mode != "reader":
                self._teardown_reader()
            self.mode = mode
            self.stack.set_visible_child_name(mode)
            for name, item in self.nav_buttons.items():
                item.remove_css_class("active")
                if name == mode:
                    item.add_css_class("active")
            if mode == "library":
                self.search.set_placeholder_text("Search offline library")
                self._refresh_library_filter()
            elif mode == "explore":
                self.search.set_placeholder_text("Search available wikis")
                if not self.catalog_loaded:
                    self.refresh_catalog(reset=True)
            elif mode == "downloads":
                self.search.set_placeholder_text("Downloads are shown below")
                self.refresh_downloads()

        def refresh_library(self) -> None:
            self.library_generation += 1
            generation = self.library_generation
            self.library_status.set_label("Scanning library…")

            def worker() -> None:
                try:
                    payload = collect_library()
                except Exception as error:
                    payload = {"books": [], "errors": [str(error)], "libraryDirs": []}
                GLib.idle_add(self._apply_library, generation, payload)

            threading.Thread(target=worker, daemon=True).start()

        def _apply_library(self, generation: int, payload: dict) -> bool:
            if generation != self.library_generation:
                return GLib.SOURCE_REMOVE
            self.library_payload = payload
            self.books = list(payload.get("books", []))
            clear_children(self.library_list)
            for book in self.books:
                self.library_list.append(ArchiveRow(book, self.open_book, self._confirm_trash))
            self._rebuild_locations(payload)
            errors = payload.get("errors") or []
            status = f"{len(self.books)} archives · {format_bytes(payload.get('totalBytes', 0))}"
            if errors:
                status += f" · SCAN INCOMPLETE: {errors[0]}"
                self.library_status.add_css_class("error")
            else:
                self.library_status.remove_css_class("error")
            if not payload.get("readerAvailable", False):
                status += " · kiwix-serve unavailable"
            self.library_status.set_label(status)
            self._refresh_library_filter()
            return GLib.SOURCE_REMOVE

        def _rebuild_locations(self, payload: dict) -> None:
            selected_path = self.active_location
            self.location_list.disconnect_by_func(self._location_selected)
            clear_children(self.location_list)
            all_row = Gtk.ListBoxRow()
            all_row.location_path = None
            all_row.set_child(label(f"All archives  {len(self.books)}"))
            self.location_list.append(all_row)
            stats = {item.get("path"): item for item in payload.get("libraryStats", [])}
            selected = all_row
            for raw_path in payload.get("libraryDirs", []):
                path = Path(raw_path)
                count = sum(1 for book in self.books if Path(book["path"]).is_relative_to(path))
                stat_data = stats.get(raw_path, {})
                detail = f"{count} · {format_bytes(stat_data.get('freeBytes') or 0)} free"
                row = Gtk.ListBoxRow()
                row.location_path = raw_path
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
                box.set_margin_start(10)
                box.set_margin_end(8)
                box.set_margin_top(5)
                box.set_margin_bottom(5)
                box.append(label(path.name or raw_path, ellipsize=True))
                box.append(label(detail, "meta", ellipsize=True))
                row.set_child(box)
                row.set_tooltip_text(raw_path)
                self.location_list.append(row)
                if raw_path == selected_path:
                    selected = row
            self.location_list.connect("row-selected", self._location_selected)
            self.location_list.select_row(selected)

        def _location_selected(self, _listbox, row) -> None:
            self.active_location = getattr(row, "location_path", None) if row else None
            self._refresh_library_filter()

        def _filter_library_row(self, row: ArchiveRow) -> bool:
            query = self.search.get_text().strip().casefold() if self.mode == "library" else ""
            if query and query not in row.search_text:
                return False
            if self.active_location:
                return Path(row.book["path"]).is_relative_to(Path(self.active_location))
            return True

        def _refresh_library_filter(self) -> None:
            if hasattr(self, "library_list"):
                self.library_list.invalidate_filter()

        def _choose_folder(self, _button) -> None:
            dialog = Gtk.FileDialog(title="Add a ZIM library folder")
            dialog.select_folder(self, None, self._folder_selected)

        def _folder_selected(self, dialog, result) -> None:
            try:
                folder = dialog.select_folder_finish(result)
            except GLib.Error:
                return
            if folder.get_path() and add_library_dir(Path(folder.get_path())):
                self.refresh_library()

        def _choose_download_folder(self, _button) -> None:
            dialog = Gtk.FileDialog(title="Choose the download location")
            dialog.select_folder(self, None, self._download_folder_selected)

        def _download_folder_selected(self, dialog, result) -> None:
            try:
                folder = dialog.select_folder_finish(result)
            except GLib.Error:
                return
            if folder.get_path() and set_download_dir(Path(folder.get_path())):
                self.refresh_library()

        def _remove_selected_location(self, _button) -> None:
            row = self.location_list.get_selected_row()
            path = getattr(row, "location_path", None) if row else None
            if not path:
                return
            if not remove_library_dir(Path(path)):
                self._show_error("Location cannot be removed", "The active download location must remain in the library.")
                return
            self.active_location = None
            self.refresh_library()

        def _confirm_trash(self, book: dict) -> None:
            dialog = Gtk.AlertDialog(
                message="Move archive to trash?",
                detail=f"{book.get('title') or book['filename']} and all matching split parts will be moved to the desktop trash.",
                buttons=["Cancel", "Move to Trash"],
                cancel_button=0,
                default_button=1,
            )
            dialog.choose(self, None, self._trash_confirmed, book)

        def _trash_confirmed(self, dialog, result, book: dict) -> None:
            try:
                accepted = dialog.choose_finish(result) == 1
            except GLib.Error:
                return
            if not accepted:
                return
            if self.reader_server and self.reader_server.archive_path == Path(book["path"]).resolve():
                self._leave_reader()

            def worker() -> None:
                try:
                    trashed = trash_archive(
                        book["path"],
                        lambda path: Gio.File.new_for_path(str(path)).trash(None),
                    )
                except Exception as error:
                    GLib.idle_add(self._show_error, "Could not trash archive", str(error))
                    GLib.idle_add(self.refresh_library)
                else:
                    GLib.idle_add(
                        self._archive_trashed, [str(path.resolve()) for path in trashed]
                    )

            threading.Thread(target=worker, daemon=True).start()

        def _archive_trashed(self, trashed_paths: list[str]) -> bool:
            removed = set(trashed_paths)
            for state in self.state_store.list_download_states():
                known_paths = state.get("output_paths") or state.get("paths") or []
                if not isinstance(known_paths, list):
                    continue
                if removed.intersection(str(Path(path).resolve()) for path in known_paths):
                    catalog_id = str(state.get("catalog_id") or "")
                    if catalog_id:
                        self.state_store.delete_download_state(catalog_id)
                    metalink_path = state.get("metalink_path")
                    if isinstance(metalink_path, str):
                        try:
                            Path(metalink_path).unlink()
                        except FileNotFoundError:
                            pass
            self.refresh_downloads()
            self.refresh_library()
            if self.catalog_loaded:
                self.refresh_catalog()
            return GLib.SOURCE_REMOVE

        def refresh_catalog(self, *, reset: bool = False) -> None:
            if reset:
                self.catalog_start = 0
            self.catalog_generation += 1
            generation = self.catalog_generation
            self.catalog_status.set_label("Loading catalog…")
            query = self.search.get_text().strip()
            language = self.language_filter.get_text().strip()
            category = self.category_filter.get_text().strip()
            size_text = self.size_filter.get_text().strip()
            try:
                maxsize = int(float(size_text) * 1_000_000_000) if size_text else None
                if maxsize is not None and maxsize < 0:
                    raise ValueError
            except ValueError:
                self._show_error(
                    "Invalid size filter", "Maximum size must be a positive number of GB."
                )
                return
            start = self.catalog_start

            def worker() -> None:
                try:
                    page = self.catalog.fetch_entries(
                        q=query or None,
                        lang=language or None,
                        category=category or None,
                        maxsize=maxsize,
                        start=start,
                        count=self.catalog_count,
                    )
                    error = None
                except Exception as failure:
                    page = None
                    error = str(failure)
                GLib.idle_add(self._apply_catalog, generation, page, error)

            threading.Thread(target=worker, daemon=True).start()

        def _apply_catalog(self, generation: int, page, error: str | None) -> bool:
            if generation != self.catalog_generation:
                return GLib.SOURCE_REMOVE
            clear_children(self.catalog_list)
            if error or page is None:
                self.catalog_status.set_label(f"CATALOG ERROR · {error}")
                self.catalog_status.add_css_class("error")
                return GLib.SOURCE_REMOVE
            self.catalog_loaded = True
            self.catalog_status.remove_css_class("error")
            for entry in page.entries:
                self.catalog_list.append(
                    CatalogRow(entry, self._catalog_entry_state(entry), self._start_download)
                )
            first = self.catalog_start + 1 if page.entries else 0
            last = self.catalog_start + len(page.entries)
            cache = " · OFFLINE CACHE" if page.from_cache else ""
            self.catalog_status.set_label(f"Catalog results {first}–{last}{cache}")
            self.previous_button.set_sensitive(self.catalog_start > 0)
            has_next = (
                len(page.entries) == self.catalog_count
                if page.total_results < 0
                else last < page.total_results
            )
            self.next_button.set_sensitive(has_next)
            return GLib.SOURCE_REMOVE

        def _catalog_entry_state(self, entry) -> str:
            transfer = self.state_store.load_download(entry.id)
            if transfer:
                return str(transfer.get("status") or "queued")
            release = entry.issued[:7]
            for book in self.books:
                filename = str(book.get("filename", "")).casefold()
                if entry.name.casefold() in filename and (not entry.flavour or entry.flavour.casefold() in filename):
                    if not release or release in filename:
                        return "installed"
            return ""

        def _clear_catalog_filters(self, _button) -> None:
            self.language_filter.set_text("")
            self.category_filter.set_text("")
            self.size_filter.set_text("")
            self.search.set_text("")
            self.refresh_catalog(reset=True)

        def _catalog_page(self, direction: int) -> None:
            self.catalog_start = max(0, self.catalog_start + direction * self.catalog_count)
            self.refresh_catalog()

        def _start_download(self, entry) -> None:
            self.catalog_status.set_label(f"Preparing {entry.title}…")

            def worker() -> None:
                try:
                    destination = Path(load_config()["downloadDir"]).expanduser()
                    destination.mkdir(parents=True, exist_ok=True)
                    manager = self._ensure_download_manager()
                    manager.add_catalog(
                        entry.id,
                        entry.downloadUrl,
                        destination,
                        expected_size=entry.sizeBytes,
                        metadata=asdict(entry),
                    )
                    state = self.state_store.load_download(entry.id) or {}
                    state["status"] = "queued"
                    self.state_store.save_download(entry.id, state)
                except Exception as error:
                    GLib.idle_add(self._show_error, "Download could not start", str(error))
                else:
                    GLib.idle_add(self._download_started, entry.title)

            threading.Thread(target=worker, daemon=True).start()

        def _download_started(self, title_text: str) -> bool:
            self.catalog_status.set_label(f"Queued {title_text}")
            self.refresh_catalog()
            self.refresh_downloads()
            return GLib.SOURCE_REMOVE

        def _ensure_download_manager(self) -> DownloadManager:
            with self.download_lock:
                if self.download_manager is None:
                    self.download_manager = DownloadManager(self.state_store)
                self.download_manager.start()
                return self.download_manager

        def refresh_downloads(self) -> None:
            states = self.state_store.list_download_states()
            clear_children(self.download_list)
            for state in states:
                self.download_list.append(DownloadRow(state, self._download_action, self.open_book))
            active = sum(1 for item in states if item.get("status") in {"queued", "downloading", "paused"})
            self.download_status.set_label(
                f"{len(states)} transfers · {active} active or paused" if states else "No downloads"
            )

        def _poll_downloads(self) -> bool:
            if self.download_polling:
                return GLib.SOURCE_CONTINUE
            states = self.state_store.list_download_states()
            pending = [
                item for item in states
                if item.get("status") not in {"completed", "error", "cancelled"}
                and item.get("gids")
            ]
            if not pending:
                return GLib.SOURCE_CONTINUE
            self.download_polling = True

            def worker() -> None:
                completed = False
                try:
                    manager = self._ensure_download_manager()
                    for state in pending:
                        previous = state.get("status")
                        try:
                            statuses = manager.poll(str(state["catalog_id"]))
                            if previous != "completed" and statuses and all(
                                item["status"] == "completed" for item in statuses
                            ):
                                completed = True
                        except Exception as error:
                            failed = dict(state)
                            failed["error"] = str(error)
                            self.state_store.save_download(str(state["catalog_id"]), failed)
                finally:
                    GLib.idle_add(self._downloads_polled, completed)

            threading.Thread(target=worker, daemon=True).start()
            return GLib.SOURCE_CONTINUE

        def _downloads_polled(self, completed: bool) -> bool:
            self.download_polling = False
            self.refresh_downloads()
            if completed:
                self.refresh_library()
            return GLib.SOURCE_REMOVE

        def _download_action(self, action: str, catalog_id: str) -> None:
            if action == "cancel":
                dialog = Gtk.AlertDialog(
                    message="Cancel download?",
                    detail="The partial archive and aria2 control file will be deleted.",
                    buttons=["Keep Download", "Cancel and Delete"],
                    cancel_button=0,
                    default_button=1,
                )
                dialog.choose(self, None, self._cancel_download_confirmed, catalog_id)
                return
            self._run_download_action(action, catalog_id)

        def _cancel_download_confirmed(self, dialog, result, catalog_id: str) -> None:
            try:
                accepted = dialog.choose_finish(result) == 1
            except GLib.Error:
                return
            if accepted:
                self._run_download_action("cancel", catalog_id)

        def _run_download_action(self, action: str, catalog_id: str) -> None:
            def worker() -> None:
                try:
                    manager = self._ensure_download_manager()
                    if action == "pause":
                        manager.pause(catalog_id)
                    elif action == "resume":
                        manager.resume(catalog_id)
                    elif action == "retry":
                        manager.retry(catalog_id)
                    elif action == "cancel":
                        manager.cancel(catalog_id)
                    if action != "cancel":
                        manager.poll(catalog_id)
                except Exception as error:
                    GLib.idle_add(self._show_error, "Download action failed", str(error))
                finally:
                    GLib.idle_add(self.refresh_downloads)

            threading.Thread(target=worker, daemon=True).start()

        def open_book(self, book: dict) -> None:
            path = str(book.get("path") or "")
            if not path:
                return
            self.reader_generation += 1
            generation = self.reader_generation
            old_server = self.reader_server
            self.reader_server = None
            self.mode = "reader"
            self.stack.set_visible_child_name("reader")
            self.reader_title.set_label(Path(path).name)
            self.reader_status.set_label("Starting private reader…")

            def worker() -> None:
                server = None
                error = None
                try:
                    if old_server:
                        old_server.stop()
                    server = ReaderServer(path).start()
                except Exception as failure:
                    error = str(failure)
                GLib.idle_add(self._reader_ready, generation, server, error)

            threading.Thread(target=worker, daemon=True).start()

        def _reader_ready(self, generation: int, server, error: str | None) -> bool:
            if generation != self.reader_generation:
                if server:
                    threading.Thread(target=server.stop, daemon=True).start()
                return GLib.SOURCE_REMOVE
            if error or server is None:
                self.reader_status.set_label(f"READER ERROR · {error}")
                self.reader_status.add_css_class("error")
                return GLib.SOURCE_REMOVE
            self.reader_server = server
            self.reader_status.remove_css_class("error")
            self.reader_status.set_label("Offline · localhost only")
            self.reader.load_uri(server.viewer_url)
            return GLib.SOURCE_REMOVE

        def _reader_home(self, _button) -> None:
            if self.reader_server:
                self.reader.load_uri(self.reader_server.home_url)

        def _leave_reader(self) -> None:
            self.show_mode("library")

        def _teardown_reader(self, *, synchronous: bool = False) -> None:
            self.reader_generation += 1
            server = self.reader_server
            self.reader_server = None
            self.reader.load_uri("about:blank")
            if server:
                if synchronous:
                    server.stop()
                else:
                    threading.Thread(target=server.stop, daemon=True).start()

        def _reader_policy(self, _view, decision, decision_type) -> bool:
            if decision_type != WebKit.PolicyDecisionType.NAVIGATION_ACTION:
                return False
            uri = decision.get_request().get_uri()
            parsed = urllib.parse.urlsplit(uri)
            if parsed.scheme in {"about", "data"}:
                return False
            allowed_port = self.reader_server.port if self.reader_server else None
            if parsed.scheme == "http" and parsed.hostname == "127.0.0.1" and parsed.port == allowed_port:
                return False
            if parsed.scheme in {"http", "https"}:
                decision.ignore()
                action = decision.get_navigation_action()
                if action and action.is_user_gesture():
                    Gio.AppInfo.launch_default_for_uri(uri, None)
                else:
                    self.reader_status.set_label("Blocked an automatic external link")
                return True
            decision.ignore()
            return True

        def _reader_load_failed(self, _view, _event, _uri, error) -> bool:
            self.reader_status.set_label(f"LOAD ERROR · {error.message}")
            self.reader_status.add_css_class("error")
            return False

        def _search_changed(self, _entry) -> None:
            if self.mode == "library":
                self._refresh_library_filter()
                return
            if self.mode != "explore":
                return
            if self.search_source:
                GLib.source_remove(self.search_source)
            self.search_source = GLib.timeout_add(450, self._search_now)

        def _search_now(self) -> bool:
            self.search_source = 0
            if self.mode == "explore":
                self.refresh_catalog(reset=True)
            elif self.mode == "library":
                self._refresh_library_filter()
            return GLib.SOURCE_REMOVE

        def _show_error(self, title: str, detail: str) -> bool:
            Gtk.AlertDialog(message=title, detail=detail, buttons=["Close"]).show(self)
            return GLib.SOURCE_REMOVE

        def _key_pressed(self, _controller, keyval, _keycode, state) -> bool:
            if state & Gdk.ModifierType.CONTROL_MASK:
                modes = {Gdk.KEY_1: "library", Gdk.KEY_2: "explore", Gdk.KEY_3: "downloads"}
                if keyval in modes:
                    self.show_mode(modes[keyval])
                    return True
            if keyval == Gdk.KEY_Escape and self.mode == "reader":
                self._leave_reader()
                return True
            if keyval == Gdk.KEY_slash and self.mode != "reader":
                self.search.grab_focus()
                return True
            return False

        def shutdown(self) -> None:
            if self.download_timer:
                GLib.source_remove(self.download_timer)
                self.download_timer = 0
            self._teardown_reader(synchronous=True)
            if self.download_manager:
                try:
                    self.download_manager.shutdown()
                except DownloadError:
                    pass

    class OmawixApplication(Gtk.Application):
        def __init__(self):
            super().__init__(
                application_id=APP_ID,
                flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
            )
            self.window: OmawixWindow | None = None
            self.provider = Gtk.CssProvider()

        def do_startup(self) -> None:
            Gtk.Application.do_startup(self)
            self.provider.load_from_data(theme_css())
            display = Gdk.Display.get_default()
            if display:
                Gtk.StyleContext.add_provider_for_display(
                    display, self.provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
                )

        def do_activate(self) -> None:
            self.window = self.window or OmawixWindow(self)
            self.window.present()

        def do_command_line(self, command_line) -> int:
            arguments = [str(value) for value in command_line.get_arguments()][1:]
            open_path = None
            if "--open" in arguments:
                index = arguments.index("--open")
                if index + 1 < len(arguments):
                    open_path = arguments[index + 1]
            elif arguments and not arguments[0].startswith("-"):
                open_path = arguments[0]
            self.activate()
            if open_path and self.window:
                path = resolve_command_line_path(open_path, command_line.get_cwd())
                self.window.open_book({"path": str(path)})
            return 0

        def do_shutdown(self) -> None:
            if self.window:
                self.window.shutdown()
            Gtk.Application.do_shutdown(self)

    return OmawixApplication().run(sys.argv)


def main() -> int:
    if "--json" in sys.argv[1:]:
        print(json.dumps(collect_library(), ensure_ascii=False))
        return 0
    return run_gui()


if __name__ == "__main__":
    raise SystemExit(main())
