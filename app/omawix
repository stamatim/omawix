    class DownloadRow(Gtk.ListBoxRow):
        def __init__(self, state: dict, action_callback, open_callback):
            super().__init__()
            self.state = state
            self.add_css_class("content-row")
            metadata = state.get("metadata") if isinstance(state.get("metadata"), dict) else {}
            title_text = str(metadata.get("title") or state.get("catalog_id") or "Download")
            status_text = str(state.get("status") or "queued")
            completed = int(state.get("completed_bytes") or 0)
            total = int(state.get("total_bytes") or state.get("required_bytes") or 0)
            speed = int(state.get("speed_bytes_per_second") or 0)
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            content.set_hexpand(True)
            content.append(label(title_text, "title", ellipsize=True))
            details = f"{status_text.upper()} · {format_bytes(completed)} / {format_bytes(total)}"
            if speed:
                details += f" · {format_bytes(speed)}/s"
            if state.get("error"):
                details += f" · {state['error']}"
            content.append(label(details, "error" if state.get("error") else "meta", ellipsize=True))
            progress = Gtk.ProgressBar()
            progress.set_fraction(min(1.0, completed / total) if total else 0.0)
            content.append(progress)
            row.append(content)
            catalog_id = str(state.get("catalog_id") or "")
            if status_text in {"queued", "downloading"}:
                row.append(button("PAUSE", lambda _b: action_callback("pause", catalog_id)))
                row.append(button("CANCEL", lambda _b: action_callback("cancel", catalog_id), "danger"))
            elif status_text == "paused":
                row.append(button("RESUME", lambda _b: action_callback("resume", catalog_id), "primary"))
                row.append(button("CANCEL", lambda _b: action_callback("cancel", catalog_id), "danger"))
            elif status_text == "error":
                row.append(button("RETRY", lambda _b: action_callback("retry", catalog_id), "primary"))
                row.append(button("REMOVE", lambda _b: action_callback("cancel", catalog_id), "danger"))
            elif status_text == "completed":
                paths = state.get("paths") if isinstance(state.get("paths"), list) else []
                if paths:
                    row.append(button("OPEN", lambda _b: open_callback({"path": paths[0]}), "primary"))
            self.set_child(row)

